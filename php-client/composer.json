{
  "name": "transcoder/socket-client",
  "description": "PHP Unix socket client for the Node.js Transcoder Service",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">= 8.1"
  },
  "autoload": {
    "psr-4": {
      "TranscoderSocket\\": "."
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TranscoderSocket\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs:check": "phpcs --standard=PSR12 .",
    "cs:fix": "phpcbf --standard=PSR12 .",
    "stan": "phpstan analyse ."
  }
}
