{
  "folders": [
    {
      "id": "videos",
      "path": "C:\\Users\\Martin\\Videos",
      "title": "My Videos",
      "scanInterval": 300
    }
  ],
  "transcode": {
    "variants": [
      {
        "height": 720,
        "bitrate": "2500k"
      }
    ],
    "preset": "veryfast",
    "audio": {
      "codec": "aac",
      "bitrate": "128k",
      "channels": 2
    },
    "trickplay": true,
    "onDemand": true,
    "idleTimeout": 5,
    "transcodeAhead": 3,
    "segmentDuration": 5,
    "hwAccel": "cpu",
    "videoCodec": "h264",
    "hlsSegmentType": "mpegts",
    "lowLatency": false,
    "audioOnly": false
  },
  "ffmpeg": "ffmpeg",
  "ffprobe": "ffprobe",
  "logging": {
    "level": "info",
    "directory": "logs",
    "maxSize": "20m",
    "maxFiles": "14d"
  },
  "cleanup": {
    "interval": 600,
    "maxAge": 86400,
    "strategy": "mtime"
  },
  "iframePath": "metadata",
  "metadataPath": "C:\\Users\\Martin\\Videos",
  "generateMetadataInterval": 3600
}